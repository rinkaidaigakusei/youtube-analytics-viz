# Google Cloud Console > APIs & Services > Credentials で発行した値をコピーする
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth同意画面の「承認済みのリダイレクトURI」に登録したものと完全一致させる
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# フロントエンドのオリジン。CORS許可用(カンマ区切りで複数指定可、パスは付けない)
# 例: http://localhost:5173,https://your-username.github.io
FRONTEND_ORIGIN=http://localhost:5173

# OAuthログイン成功後にリダイレクトする実際のページURL(GitHub Pagesはリポジトリ名の
# サブパスで配信されるため、FRONTEND_ORIGINとは別にフルパスで指定する)
POST_LOGIN_REDIRECT_URL=http://localhost:5173/

# APIを使うための合言葉(長くて推測されにくいものにする)。未設定だとAPIは全リクエストを拒否する。
# フロントエンドを開いたときに、同じ値を入力する
APP_PASSWORD=change-me-to-a-long-random-string

# ローカルキャッシュの保存先(相対パス。backend/ 直下から見た位置)
TOKEN_FILE=data/token.json
DB_FILE=data/cache.db

# 投稿曜日・時間帯を集計する際に使うタイムゾーン
TIMEZONE=Asia/Tokyo
